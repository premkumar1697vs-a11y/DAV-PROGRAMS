    "\n",
    "print(df.describe())\n",
    "\n",
    "sns.set_style(\"whitegrid\")\n",
    "\n",
    "# Histogram\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.histplot(data=df, x=\"SepalLengthCm\", bins=10)\n",
