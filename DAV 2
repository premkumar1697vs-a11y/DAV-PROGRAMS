    "import pandas as pd\n",
    "\n",
    "# Load the dataset\n",
    "df = pd.read_csv(r\"C:\\Users\\ROSY\\Downloads\\archive\\student_performance.csv\")\n",
    "print(\"Dataset loaded successfully!\")\n",
    "\n",
    "print(\"\\nFirst 5 rows:\")\n",
    "print(df.head())\n",
    "\n",
    "print(\"\\nLast 5 rows:\")\n",
    "print(df.tail())\n",
    "\n",
    "print(\"\\nShape of the dataset:\")\n",
    "print(df.shape)\n",
    "\n",
    "print(\"\\nColumn names:\")\n",
    "print(df.columns)\n",
    "\n",
    "print(\"\\nData types:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "# EDA\n",
    "print(\"\\nDescriptive Statistics:\")\n",
    "print(df.describe())\n",
    "\n",
    "print(\"\\nStatistics including categorical columns:\")\n",
    "print(df.describe(include='all'))\n",
    "\n",
    "print(\"\\nMissing values in each column:\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "print(\"\\nNumber of duplicate rows:\")\n",
    "print(df.duplicated().sum())\n",
    "\n",
    "print(\"\\nNumber of duplicate student IDs:\")\n",
    "print(df['student_id'].duplicated().sum())\n",
    "\n",
    "print(\"\\nNumber of students in each grade:\")\n",
    "print(df['grade'].value_counts())\n",
    "\n",
    "# Data wrangling: merge\n",
    "grade_info = pd.DataFrame({\n",
    "    'grade': ['A', 'B', 'C', 'D', 'F'],\n",
    "    'grade_description': ['Excellent', 'Good', 'Average', 'Below Average', 'Fail']\n",
    "})\n",
    "print(\"\\nGrade Information DataFrame:\")\n",
    "print(grade_info)\n",
    "\n",
    "merged = pd.merge(df, grade_info, on='grade', how='left')\n",
    "print(\"\\nMerged DataFrame:\")\n",
    "print(merged.head())\n",
    "\n",
    "# Join\n",
    "grade_details = pd.DataFrame({\n",
    "    'description': ['Excellent', 'Good', 'Average', 'Below Average', 'Fail'],\n",
    "    'performance_level': ['Very High', 'High', 'Medium', 'Low', 'Very Low']\n",
    "}, index=['A', 'B', 'C', 'D', 'F'])\n",
    "\n",
    "grade_counts = df['grade'].value_counts().to_frame('student_count')\n",
    "joined = grade_counts.join(grade_details)\n",
    "print(\"\\nJoined DataFrame:\")\n",
    "print(joined)\n",
    "\n",
    "# Concatenation\n",
    "df1 = df.iloc[:100]\n",
    "df2 = df.iloc[100:200]\n",
    "combined = pd.concat([df1, df2])\n",
    "print(\"\\nConcatenated DataFrame:\")\n",
    "print(combined.head())\n",
    "print(\"\\nShape after concatenation:\")\n",
    "print(combined.shape)"
